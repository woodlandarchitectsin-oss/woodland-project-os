{
  "name": "woodland-project-os",
  "version": "1.0.0",
  "private": true,
  "description": "Woodland Project OS - installable, shared, offline-capable project manager",
  "scripts": {
    "check": "node scripts/syntax-check.js",
    "stamp": "node scripts/stamp.js",
    "test": "node scripts/syntax-check.js && node --test --test-concurrency=1 test/*.test.js",
    "test:fast": "node scripts/syntax-check.js && node --test test/backend.test.js",
    "icons": "node scripts/make-icons.js",
    "deploy:pages": "node scripts/deploy-pages.js"
  },
  "devDependencies": {
    "pixelmatch": "5.3.0",
    "playwright": "^1.64.1",
    "pngjs": "7.0.0",
    "xlsx": "^0.18.5"
  }
}
